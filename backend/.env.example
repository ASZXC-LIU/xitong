SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///data.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 开发管理员必须显式配置，不提供默认生产密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-development-password
ADMIN_DISPLAY_NAME=管理员

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# 仅本机调试：生产环境必须保持 development 以外的值，并保持开关为 false。
APP_ENV=production
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMPLOYEE_PHONE=
DEV_LOGIN_EMPLOYEE_NAME=本地调试员工

# 员工微信手机号快捷登录；Secret 仅配置在本机或部署环境，禁止提交。
WECHAT_APP_ID=wxdf7bba648b27e7db
WECHAT_APP_SECRET=
